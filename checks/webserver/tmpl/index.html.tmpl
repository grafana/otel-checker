<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTel Checker</title>
    <link href="/static/style.css" type="text/css" rel="stylesheet"/>
</head>
<body>
    <section class="header">
        <h1>OTel Checker</h1>
    </section>

    {{if .Results.Checks}}
    <h2 class="checks">checks</h2>
    <ul>
    {{range .Results.Checks}}
        <li>{{.Component}}: {{.Message}}</li>
    {{end}}
    </ul>
    {{end}}

    {{if .Results.Warnings}}
    <h2 class="warnings">warnings</h2>
    <ul>
    {{range .Results.Warnings}}
        <li>{{.Component}}: {{.Message}}</li>
    {{end}}
    </ul>
    {{end}}

    {{if .Results.Errors}}
    <h2 class="errors">errors</h2>
    <ul>
    {{range .Results.Errors}}
        <li>{{.Component}}: {{.Message}}</li>
    {{end}}
    </ul>
    {{end}}
</body>
</html>
