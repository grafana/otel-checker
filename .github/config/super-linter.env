# launch.json contains JSONC (comments) which fails plain JSON validation
# supported-libraries.yaml files are generated by scripts/
FILTER_REGEX_EXCLUDE=(renovate-tracked-deps\.json|\.vscode/launch\.json|supported-libraries\.yaml)
IGNORE_GITIGNORED_FILES=true
LOG_LEVEL=ERROR

# single CSS file not worth linting
VALIDATE_CSS=false
VALIDATE_CSS_PRETTIER=false
# lint:go uses mise-pinned golangci-lint instead
VALIDATE_GO=false
VALIDATE_GO_MODULES=false
VALIDATE_JSCPD=false
VALIDATE_NATURAL_LANGUAGE=false
# super-linter's Python linters conflict with local tooling
VALIDATE_PYTHON_FLAKE8=false
VALIDATE_PYTHON_ISORT=false
VALIDATE_PYTHON_MYPY=false
VALIDATE_PYTHON_PYLINT=false
VALIDATE_PYTHON_RUFF_FORMAT=false

FIX_ENV=true
FIX_JSON=true
FIX_JSONC=true
FIX_JSONC_PRETTIER=true
FIX_JSON_PRETTIER=true
FIX_MARKDOWN=true
FIX_MARKDOWN_PRETTIER=true
FIX_SHELL_SHFMT=true
FIX_SPELL_CODESPELL=true
FIX_YAML_PRETTIER=true
